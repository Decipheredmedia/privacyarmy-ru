# Base URL where the site is deployed, without a trailing slash.
SITE_BASE_URL=https://privacyarmy.example.com

# NOWPayments API key used by /api/create_payment.php.
NOWPAYMENTS_API_KEY=replace-with-nowpayments-api-key

# Shared secret used to verify NOWPayments IPN callbacks.
NOWPAYMENTS_IPN_SECRET=replace-with-nowpayments-ipn-secret

# SMTP hostname for transactional mail delivery.
SMTP_HOST=smtp.example.com

# SMTP port for transactional mail delivery.
SMTP_PORT=587

# SMTP username used for authentication.
SMTP_USER=mailer@example.com

# SMTP password used for authentication.
SMTP_PASS=replace-with-smtp-password

# From address shown on outgoing store emails.
SMTP_FROM=orders@example.com

# Human-friendly sender name for outgoing store emails.
SMTP_FROM_NAME=PrivacyArmy

# Support inbox that receives contact-form submissions and admin alerts.
SUPPORT_EMAIL=support@example.com

# Password hash for /admin/index.php generated with PHP password_hash().
ADMIN_PASSWORD_HASH=$2y$10$replace.with.a.real.password_hash.value
